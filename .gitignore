# Secrets — never commit
.env
service_account.json
*service-account*.json
*service_account*.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Local artifacts
*.output

# Student data / uploads / generated sheets — never commit (PII)
*.pdf
# A page image rendered from an answer sheet IS the answer sheet: the
# student's handwriting, name and marks. Review runs produce them by the
# hundred beside the copies they check.
*.png

# Editor/agent state + archives (not needed in the repo)
.claude/
*.zip

# PyInstaller output (the EXE is distributed outside git)
build/
dist/
/build_final_*/
/dist_new/
/release_final_*/
*.log

# Local public OAuth configuration used for desktop packaging
/pw_oauth_config.json

# Per-user authentication/configuration
client_config.json
token.txt
/build_log.txt

# Faculty/review runs: report.json and ocr.json carry the student's transcribed
# handwriting and their marks, which is the answer sheet in another format. The
# *.pdf / *.png rules above miss them because they are JSON.
/ca_corporate_law_review/
/ca_fm_sm_review/
/ca_taxation_review/
/faculty_review_v5/
/physics_review_*/

# Generated accuracy/benchmark runs (inputs may contain student PII)
/ab_fanout*/
/ab_scheme/
/ab_single/
/bl_*/
/ca_audit_*/
/ca_final/
/ca_run*/
/ca_v*/
/ca100_*/
/cache_run*/
/chem*/
/claude_*/
/commerce_*/
/coremaths_mat/
/eval_ca_*/
/eval_commerce_out/
/haiku_commerce/
/pilot_*/
/sweep_*/

# Outputs from retired/manual rendering probes
/test_*.pdf
/test_*.png
workflow_data/
pw_skills_data/
.workflow-test-*/

# Checked copies delivered to a teacher: marks_index.csv carries student IDs
# against their scores, and the audit/report JSON beside it names the copy.
# The PDFs and page images are caught above; these are not. (25 Nov 2026)
deliveries/

# Scratch roots left by test runs and by the Vidyapeeth planner, which hold
# student_results.csv / .xlsx written from real sheets.
tmp/
.test-*/
.test_tmp/
.pytest-tmp/
*.stackdump

# pytest basetemp roots used by tools/selftest.py (.pt27, .pt28, ...)
.pt[0-9]*/
