# Secrets — never commit
.env
service_account.json
*service-account*.json
*service_account*.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Local artifacts
*.output

# Student data / uploads / generated sheets — never commit (PII)
*.pdf
# A page image rendered from an answer sheet IS the answer sheet: the
# student's handwriting, name and marks. Review runs produce them by the
# hundred beside the copies they check.
*.png

# Editor/agent state + archives (not needed in the repo)
.claude/
*.zip

# PyInstaller output (the EXE is distributed outside git)
build/
dist/
/build_final_*/
/dist_new/
/release_final_*/
*.log

# Local public OAuth configuration used for desktop packaging
/pw_oauth_config.json

# Per-user authentication/configuration
client_config.json
token.txt
/build_log.txt

